若被情傷，十日將如凡人一年，直至墮入輪迴化為枯木，情傷愈重，木質色澤愈黑，化毒藥性愈強。    芳華絕色，世間難尋，此獸乃至情至性之物，終其一生為情所困，終逃不脫情殤之劫，成正果者少之又少。)[2;37;0m","nj":28,]),([]),1,/),(/"[1;36m洞天仙府令[2;37;0m","dongtian ling",({"dongtian ling","ling",}),"/d/dongtian/songshan/lingpai3",(["value":30000000,"name":"[1;36m洞天仙府令[2;37;0m","dt_name":"金剛崖","dt_time":1586396770,"id":"dongtian ling","weight":2000,"dt_value":3,"unit":"枚",]),([]),1,/),(/"[1;36m洞天仙府令[2;37;0m","dongtian ling",({"dongtian ling","ling",}),"/d/dongtian/songshan/lingpai3",(["value":30000000,"name":"[1;36m洞天仙府令[2;37;0m","dt_name":"金剛崖","dt_time":1586396788,"id":"dongtian ling","weight":2000,"dt_value":3,"unit":"枚",]),([]),1,/),(/"[1;36m洞天仙府令[2;37;0m","dongtian ling",({"dongtian ling","ling",}),"/d/dongtian/songshan/lingpai3",(["value":30000000,"name":"[1;36m洞天仙府令[2;37;0m","dt_name":"金剛崖","dt_time":1586396795,"id":"dongtian ling","weight":2000,"dt_value":3,"unit":"枚",]),([]),1,/),(/"[1;36m洞天仙府令[2;37;0m","dongtian ling",({"dongtian ling","ling",}),"/d/dongtian/songshan/lingpai3",(["value":30000000,"name":"[1;36m洞天仙府令[2;37;0m","dt_name":"金剛崖","dt_time":1586396800,"id":"dongtian ling","weight":2000,"dt_value":3,"unit":"枚",]),([]),1,/),(/"[1;36m洞天仙府令[2;37;0m","dongtian ling",({"dongtian ling","ling",}),"/d/dongtian/songshan/lingpai3",(["value":30000000,"name":"[1;36m洞天仙府令[2;37;0m","dt_name":"金剛崖","dt_time":1586396857,"id":"dongtian ling","weight":2000,"dt_value":3,"unit":"枚",]),([]),1,/),(/"[1;36m洞天仙府令[2;37;0m","dongtian ling",({"dongtian ling","ling",}),"/d/dongtian/songshan/lingpai3",(["value":30000000,"name":"[1;36m洞天仙府令[2;37;0m","dt_name":"金剛崖","dt_time":1586396960,"id":"dongtian ling","weight":2000,"dt_value":3,"unit":"枚",]),([]),1,/),(/"[1;36m洞天仙府令[2;37;0m","dongtian ling",({"dongtian ling","ling",}),"/d/dongtian/songshan/lingpai3",(["value":30000000,"name":"[1;36m洞天仙府令[2;37;0m","dt_name":"金剛崖","dt_time":1586396963,"id":"dongtian ling","weight":2000,"dt_value":3,"unit":"枚",]),([]),1,/),(/"[1;36m洞天仙府令[2;37;0m","dongtian ling"