37;0m","puti zi",({"puti zi","zi",}),"/clone/gift/puti-zi",0,0,70,/),(/"[1;32m天香玉露[2;37;0m","magic water",({"magic water","yvlu","lu",}),"/clone/gift/tianxiang",0,0,60,/),(/"[1;36m芳[1;33m華[1;37m木[2;37;0m","mu",({"mu",}),"/u/redl/obj/fanghuamu",(["no_steal":1,"value":1,"auto_load":1,"no_beg":1,"set_data":1,"weight":800000,"longx":"[1;30m(                          芳華獸的傳說    芳華獸皆為雄獸，性安，獨居，身形與凡人無異，尤善植奇花異草珍藥，濯然而名，花同華，故名芳華獸。    芳華獸，少言，神色多寂寥。膚白如凝脂，終年異香，眉眼下有硃砂痣。淚痣顏色愈淺愈年少，直至殷紅、暗紅、墨黑，芳華獸亡之。    獸亡後自浴火海，化為一截枯木，曰芳華木。此木乃芳華獸之精魄，可解萬世之毒。如將木埋入土中，將藥草、花瓣碾碎加之晨曦露滴哺之，一月後枯木紅而似火，質地如玉；再二月，顏色褪淡，木上長出四肢；再三月，木出五官，似成年人，既而木質變柔，白而無瑕；又四月，木根斷，芳華獸出世。若獸成形之十月期，以摯愛之血為引每日濯之，乃續魂，幼獸尚能保留前世記憶。出世後的幼獸不通人語，食花蜜、花瓣及少量藥草為食，但成長極其快，不出半歲身形便與人類小孩無異，此時便言語流暢，極其聰慧，此後十天便如人類小孩一年，直至成年。    芳華獸乃至情之物，若成年獸不墮紅塵，心如明鏡，可長命乃至修仙，動情者便如荒草，歲歲枯榮，浴入火海，反覆輪迴。若被情傷，十日將如凡人一年，直至墮入輪迴化為枯木，情傷愈重，木質色澤愈黑，化毒藥性愈強。    芳華絕色，世間難尋，此獸乃至情至性之物，終其一生為情所困，終逃不脫情殤之劫，成正果者少之又少。)[2;37;0m","name":"[1;36m芳[1;33m華[1;37m木[2;37;0m","id":"mu","unit":"根","nj":30,]),([]),1,/),(/"[1;37m寰宇天晶[2;37;0m","tian jing",({"tian jing","tian","jing",}),"/clone/goods/tianjing",0,0,1,/),(/"[1;37m鎮獄驚天丸[2;37;0m","zhenyu wan",({"zhenyu wan","zhenyu","wan",}),"/clone/fam/max/zhenyu",0,0,1,/),(/"[1;31m子午龍甲丹[2;37;0m","longjia dan",({"longjia dan","longjia","dan",}),"/clone/fam/max/longjia",0,0,1,/),(/"[1;32m九花玉露丸[2;37;0m","jiuhua wan",({"jiuhua wan","wan",}),"/clone/medicine/jiuhua",0,0,39,/),(/"[1;35m帝王符圖碎片-33[2;37;0m","diwang suipian33",({"diwang suipian33","diwang","suipian",}),"/clone/tuteng/diwang-suipian33",0,0,18,/),(/"[1;36m帝王符圖碎片-24[2;37;0m","diwang suipian24",({"diwang suipian24","diwang","suipian",}),"/clone/tuteng/diwang-suipian24",0,0,14,/),(/"[1;36m帝王符圖碎片-26[2;37;0m","diwang suipian26",({"diwang suipian26","diwang","suipian",}),"/clone/tuteng/diwang-suipian26",0,0,16,/),(/"[1;36m帝王符圖碎片-25[2;37;0m","diwang suipian25",({"diwang suipian25","diwang","suipian",}),"/clone/tuteng/diwang-suipian25",0,0,32,/),(/"[1;36m帝王符圖碎片-27[2;37;0m","diwan