dbase (["capacity":100,"name":"[33m金山[2;37;0m","no_get":1,"board_id":"jinchuan_b","notes":({(["title":"no.1","msg":"rt你得意的作出勝利的手勢！！ 「 V 」 說：「 哈哈哈...」 * ya 每天晚上兩次公開打撈，20點和21點，進來前ask zheng all可以獲取更多幫助信息[1;30m ·· 回首向來蕭瑟處,也無風雨也無晴 ·· [2;37;0m[2;37;0m[2;37;0m","time":1444200543,"author":"紅蓮老祖","owner":"redl",]),(["title":"船升級版本後初探","owner":"ssyunone","author":"渡歐","time":1444307331,"msg":"進去後   金船艙門(door)touch door金船艙門上金光閃閃地顯出一個字：“癸”。一直到 金船艙門上金光閃閃地顯出一個字：“甲”。站在這裡不自動PK 是不自動，還是可以PK 的其他的還是一樣，10分鐘後，開始每3分鐘產生1顆廣成金丹金丹加內力上限、經驗還有悟性先天1點但是幾率還是不高上面有call die的特別牛九陰這次還發現了 胡家 的，牛……【 氣 血 】 9071671384/ 9071671384 (100%)    【 內 力 】 649183279 / 654622216 (+173670)小樓一夜聽春雨：圓月落，刀光起。縱橫大地十萬裡。刀光寒如雪，何處聽春雨？所有的聲音都沉寂，所有的動作都停頓。金船水鬼還是像一瞬前那麼樣靜靜地站在那裡，好像根本沒有動過。可是金船水鬼手裡的鋼刀已經在滴著血。你撲在地上掙扎了幾下，腿一伸，口中噴出幾口鮮血，死了！ 裡面迷宮一樣還沒摸清楚到處走動，可以得萬象天書、內力丹待後續，第一次進不要忘記了 maphere -m哦很好的指令！[2;37;0m",]),(["title":" 繼續","msg":"set no_teach check_idle此次 專門講哈xi 和touch 指令xi 你伸掌從艙底的破洞處，向著元江漩渦下面的地肺運功一吸，得到一條金行元磁真氣。每個地方只能xi 1次set no_teach check_idle而是touch指令set no_teach check_idleset no_teach check_idleset no_teach check_idleset no_teach check_idle 甲乙丙丁…… 次數是65536、32768……256、128、64、32次一個人是不可能touch 完的技巧：組隊進去set no_teach check_idleABCD,A進去後一路xi到 金船艙門 處touchset no_teach check_idle然後B進去 到金船艙門 處touch此處不自動PKset no_teach check_idle依次進去共同努力一共131040次！[2;37;0m","time":1444731898,"author":"渡歐","owner":"ssyunone",]),(["title":"qi","owner":"redl","author":"紅蓮老祖","time":1445001241,"msg":"開始閱讀文件：/u/redl/teleport/yuanjiang/npc/qi.c// This program is a part of NT MudLIB// redl 2015/10// /u/redl/teleport/yuanjiang/npc/qi.c#include <ansi.h>inherit BOSS;void create(){        set_name(CYN \"齊靈雲\" NOR, ({ \"qi lingyun\", \"qi\" }) );        set(\"title\", HIG \"蜀山\" HIC \"劍俠\" NOR);        set(\"long\", HIR \"這是傳說中的蜀山第三代精英弟子，此來是為了元江金船奪寶。\\n\" NOR);        set(\"gender\", \"女性\");        set(\"family/family_name\", \"峨嵋派\");        set(\"age\", 26);        set(\"str\", 50);        set(\"int\", 50);        set(\"con\", 50);        set(\"dex\", 50);        set(\"shen\", 8000000);        set_temp(\"apply/attack\", 1000000);        set_temp(\"apply/unarmed_damage\", 150000);        set_temp(\"apply/damage\", 150000);        set_temp(\"apply/armor\", 800000);        set(\"max_qi\", 800000000000);        set(\"eff_qi\", 800000000000);        set(\"qi\", 800000000000);        set(\"max_jing\", 150000000000);        set(\"jing\", 150000000000);        set(\"eff_jing\", 150000000000);        set(\"max_jingli\", 500000000);        set(\"jingli\", 500000000);        set(\"max_neili\", 2500000000);        set(\"neili\", 2500000000);        set(\"jiali\", 2000000);        set(\"combat_exp\", 80000000000);        set(\"level\", 200 + random(101));        set_skill(\"strike\", 16500);        set_skill(\"piaoxue-zhang\", 16500);        set_skill(\"claw\", 16500);        set_skill(\"jiuyin-baiguzhao\", 16500);        set_skill(\"finger\", 16500);        set_skill(\"tiangang-zhi\", 16500);        set_skill(\"sword\", 16500);        set_skill(\"yitian-jian\", 16500);        set_skill(\"parry\", 16500);        set_skill(\"force\", 16500);        set_skill(\"linji-zhuang\", 16500);        set_skill(\"emei-jiuyang\", 16500);        set_skill(\"dodge\", 16500);        set_skill(\"zhutian-bu\", 16500);        set_skill(\"martial-cognize\", 16500);        set_skill(\"force-cognize\", 16500);        set_skill(\"jingxin\", 2000);        set_skill(\"mahayana\", 6000);        set_skill(\"literate\", 8800);        set_skill(\"zuoyou-hubo\", 1000);        set_skill(\"array\", 1000);        map_skill(\"strike\", \"piaoxue-zhang\");        map_skill(\"parry\", \"piaoxue-zhang\");        map_skill(\"claw\", \"jiuyin-baiguzhao\");        map_skill(\"finger\", \"tiangang-zhi\");        map_skill(\"force\", \"linji-zhuang\");        map_skill(\"dodge\", \"zhutian-bu\");        map_skill(\"sword\", \"yitian-jian\");        prepare_skill(\"strike\", \"piaoxue-zhang\");        set_skill(\"mingyu-gong\", 13000);        set_skill(\"fumo-jian\", 13000);        set_skill(\"wushen-jian\", 13000);        set_skill(\"yuenv-jian\", 13000);        set_skill(\"kuihua-mogong\", 13000);        set_skill(\"huifeng-jian\", 13000);        set_skill(\"never-defeated\", 13000);        set_skill(\"tianjian\", 13000);        set_skill(\"tangshi-jian\", 13000);        set_skill(\"sword-cognize\", 11000);        set(\"tianyishenjiu_time\", 100);        set(\"chat_chance\", random(40) + 80);        set(\"chat_msg\", ({                                (: random_move :),                                (: random_move :),                                (: random_move :),                (: command(\"eat guiyuan dan\") :),                                (: exert_function, \"powerup\" :),                                (: exert_function, \"zhixin\" :),                                (: exert_function, \"fengyun\" :),                                (: exert_function, \"niepan\" :),        }));        //set(\"auto_perform\", 1);        set(\"can_perform/yitian-jian/zhen\", 30000);        set(\"chat_chance_combat\", 120);        set(\"chat_msg_combat\", ({              (: command(\"eat guiyuan dan\") :),              (: command(\"perform finger.ling\") :),              (: command(\"perform finger.ling\") :),              (: command(\"perform finger.ling\") :),              (: command(\"perform strike.zhao\") :),              (: command(\"perform sword.zhen\") :),        }));        set(\"rewards\", ([                \"exp\"   : 500000,                \"pot\"   : 250000,                \"mar\"   : 100000,                \"weiwang\" : 20000,                \"score\" : 20000,                \"gold\"  : 10000,        ]));        set_temp(\"apply/reduce_damage\", 78);        set_temp(\"apply/reduce_busy\", 35);        setup();        carry_object(\"/kungfu/class/quanzhen/obj/magrobe\")->wear();        carry_object(__DIR__\"obj/qinggangjian\")->wield();        carry_object(\"/clone/medicine/guiyuan\");}int accept_hit(object me){        this_object()->kill_ob(me);        return 1;}int accept_fight(object me){        this_object()->kill_ob(me);        return 1;}int accept_kill(object me){        this_object()->kill_ob(me);        return 1;}varargs void unconcious(object defeater){        die(defeater);        return;}void init(){        object me, ob;        me = this_object();        ob = this_player();                if (!ob->is_character()) return;        if (environment() && query(\"no_fight\", environment())) return;        if (!(__DIR__\"obj/door\"->is_attacker(ob))) return;        tell_object(ob, NOR CYN + query(\"name\", me) + NOR + CYN \"嗔怒道：就憑你也想和我峨眉爭奪廣成金船？\\n\" NOR);        me->kill_ob(ob);}[1;30m ·· 回首向來蕭瑟處,也無風雨也無晴 ·· [2;37;0m[2;37;0m[2;37;0m",]),(["title":"廣成金丹 與 倉","owner":"ssyunone","author":"渡歐","time":1445086249,"msg":"上船得的物品獎勵！  1、廣成金丹你的額外內力上限增加了一萬六千六百四十一點。你在吞下廣成金丹之後，你獲得了六千六百萬點經驗、二千萬點潛能、霸;王教主獲得經驗零點、元神獲得經驗零點、能力得到了提升。甲乙丙丁戊己庚辛壬癸倉的區別！1、金船艙門上金光閃閃地顯出一個字：“癸”。一粒造化紫箐丹(Zaohua dan);【閒聊】聽說渡歐從廣成金船的癸字艙逃出生天。2、金船艙門上金光閃閃地顯出一個字：“辛”。二粒造化紫箐丹(Zaohua dan);【閒聊】聽說渡歐從廣成金船的辛字艙逃出生天。3、金船艙門上金光閃閃地顯出一個字：“己”。天地烘爐（tiandi lu)六粒造化紫箐丹(Zaohua dan);你撲在地上掙扎了幾下，腿一伸，口中噴出幾口鮮血，死了！其他倉待續……癸壬辛庚己戊丁丙乙甲   水怪越來越多！[2;37;0m",]),(["title":"更新後的 繼續","msg":"廣成金船    這裡明顯的出口是 south、north 和 east。  金船寶箱(box)  陷阱(trap A) open box 成功後，精氣和氣血所剩無幾要抓緊吃藥！ 不過經驗可觀哦  單倍經驗6000萬金船寶箱(box)你運轉真氣到手上，用力去掀箱子的頂蓋。箱子嘭地炸開，一點黑星掙脫了漩渦飛進你的手裡，你趕緊張嘴往喉嚨裡一倒。廣成金船底部嗡地一響，一股漩渦之力吸住四閫你在吞下廣成鐵丹之後，你獲得了六千六百萬點經驗、一千萬點潛能、霸。 xi你伸掌從艙底的破洞處，向著元江漩渦下面的地肺運功一吸，得到一條水行元磁真氣。金.###  木.$##  土.###  水.###  火.####  廣成金船    這裡明顯的出口是 south、north 和 east。  金船寶箱(box)  陷阱(trap A) open box 成功後，精氣和氣血所剩無幾要抓緊吃藥！ 不過經驗可觀哦  單倍經驗6000萬金船寶箱(box)你運轉真氣到手上，用力去掀箱子的頂蓋。箱子嘭地炸開，一點黑星掙脫了漩渦飛進你的手裡，你趕緊張嘴往喉嚨裡一倒。廣成金船底部嗡地一響，一股漩渦之力吸住四閫你在吞下廣成鐵丹之後，你獲得了六千六百萬點經驗、一千萬點潛能、霸。 xi你伸掌從艙底的破洞處，向著元江漩渦下面的地肺運功一吸，得到一條