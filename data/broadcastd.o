push_msg (["walk":(["delay":2000,"broadcast_times":1101,"msg":"同一區域的某個去處可以用指令 walk <目的地> 去往該地。","times":999999999,"last_broadcast":1767898981,]),"newbie":(["delay":600,"broadcast_times":85,"msg":"新手快速晉級教程 help start & help start2 查看。","times":99999999,"last_broadcast":1767900427,]),"flower":(["delay":1000,"broadcast_times":2243,"msg":"新玩家可以找巫師獲得導師評價票4張，用來給予新手導師評價(help flowers)，以督促新手導師認真負責幫助新人。","times":99999999,"last_broadcast":1767899996,]),"tutor":(["delay":800,"broadcast_times":3296,"msg":"如果你在遊戲中有任何困難或疑問請向新手導師諮詢，使用 who -v 指令可查閱在線的新手導師。","times":99999999,"last_broadcast":1767900610,]),"bug":(["delay":1050,"broadcast_times":2506,"msg":"本站巫師只接受處理bug -a提交的bug以及客服處提交的建議,對於chat、tell等一律不給予答覆！","times":99999999,"last_broadcast":1767900245,]),"robber":(["delay":900,"broadcast_times":2752,"msg":"設置combatd null和combat_brief將會提高機器人效率，降低網絡負擔。;","times":99999999,"last_broadcast":1767900393,]),])
