// Silencer@fengyun4

#include <ansi.h>
#include <combat.h>
inherit F_CLEAN_UP;

int perform(object me, object target)
{
        int skill, duration;
        object weapon;
        mapping buff;

        if( me->query("class") != "lama" ) {
                return notify_fail("只有大昭子弟才能使用『降龍式』\n");
        }
        skill = me->query_skill("fengmo-staff", 1);             
        if( skill < 120 ) {
                return notify_fail("『降龍式』需要120級的瘋魔杖法！\n");
        }
        if( me->query_temp("pfm/fengmo_2") || me->query_temp("pfm/fengmo_1") || me->query_temp("pfm/fengmo_3") ) {
                return notify_fail("你已經在使用類似的武功了。\n");
        }    
        duration = me->query("timer/pfm/fengmo_2") - time() + 480 - F_ABILITY->check_ability(me, "xianglong_add") * 24;
        if( duration > 0 ) {
                return notify_fail("你還需要等待"+duration+"秒鐘左右才能再次使用『降龍式』\n");
        }
        if( !target ) {
                target = me;
        }
        if( target != me ) {
                return  notify_fail("『降龍式』只能用在自己身上。\n");
        }     
        if( me->query("force") < 100 ) {
                return  notify_fail("『降龍式』需要100點內力。\n");     
        }
        if( userp(me) ) {
                me->add("force", -100);
        }
        weapon = me->query_temp("weapon");

        buff =
        ([
                "caster":me,
                "who":me,
                "type":"pfm/fengmo",
                "att":"bless",
                "name":"瘋魔杖法·降龍式",
                "buff1":"pfm/fengmo_2",
                "buff1_c":1,
                "buff2":"buff/berserk_attack",
                "buff2_c":1,
                "time":40,
                "buff_msg":HIY"
$N"HIY"一聲暴喝，手中"+weapon->name()+HIY"一陣亂舞，竟似毫無章理，揮舞出數道杖影，
氣勢澎湃，力不可擋。跌出七八步，忽又衝出三五步，正是瘋魔杖法的
第二段起手式。。。。"HIR"降龍！\n\n"NOR,
                "disa_msg":YEL"你一套『降龍式』演化完畢，穩住身形。\n"NOR,
                "special_func":0,
        ]);
        ANNIE_D->buffup(buff);
    
        me->set_temp("buff/berserk_skill", "fengmo-staff");
        me->set_temp("buff/berserk_attack_msg", CYN"$N形似瘋虎，杖聲呼呼，劈頭蓋臉又向$n擊到！\n"NOR);          
        me->set("timer/pfm/fengmo_2", time());
        me->start_call_out((: call_other, __FILE__, "remove_effect", me :), 40);
        return 1;
}

int remove_effect(object me)
{
        if( !me ) {
                return 0;
        }
        me->delete_temp("buff/berserk_skill");
        me->delete_temp("buff/berserk_attack_msg");
        return 1;
}


