- 未完(380) - (回車繼續，q 離開，b 前一頁，<num> 到第 n 行，n<num>顯示接下 n 行)



151                             (: perform_action, \"staff.lun\" :),
152                             (: exert_function, \"recover\" :),
153                         (: exert_function, \"powerup\" :),
154                             (: exert_function, \"shield\" :),
155                             }) )

156                             break

157                     case 3:
158                             set_skill(\"finger\", ntmp + 200)

159                             set_skill(\"tougu-zhen\", ntmp + 200)

160                             map_skill(\"finger\", \"tougu-zhen\")

161                             set_skill(\"parry\", ntmp)

162                             map_skill(\"parry\", \"tougu-zhen\")

163                                     prepare_skill(\"finger\", \"tougu-zhen\")

164                             set(\"chat_chance_combat\", 100)

165                             set(\"chat_msg_combat\", ({
166                             (: perform_action, \"finger.feng\" :),
167                             (: perform_action, \"finger.feng\" :),
168                             (: perform_action, \"finger.feng\" :),
169                             (: exert_function, \"recover\" :),
170                         (: exert_function, \"powerup\" :),
171                             (: exert_function, \"shield\" :),
172                             }) )

173                             break

174                     case 2:
175                             set_skill(\"blade\", ntmp)

176                             set_skill(\"jinwu-blade\", ntmp)

177                             map_skill(\"blade\", \"jinwu-blade\")

178                             set_skill(\"parry\", ntmp)

179                             map_skill(\"parry\", \"jinwu-blade\")

180                             set(\"chat_chance_combat\", 100)

- 未完(380) - (回車繼續，q 離開，b 前一頁，<num> 到第 n 行，n<num>顯示接下 n 行)



181                             set(\"chat_msg_combat\", ({
182                             (: perform_action, \"blade.chi\" :),
183                             (: perform_action, \"blade.chi\" :),
184                             (: perform_action, \"blade.jinwu\" :),
185                             (: exert_function, \"recover\" :),
186                         (: exert_function, \"powerup\" :),
187                             (: exert_function, \"shield\" :),
188                             }) )

189                             break

190                     default:
191                             set_skill(\"strike\", ntmp)

192                             set_skill(\"yinlong-shou\", ntmp)

193                             map_skill(\"strike\", \"yinlong-shou\")

194                             set_skill(\"parry\", ntmp)

195                             map_skill(\"parry\", \"yinlong-shou\")

196                                     prepare_skill(\"strike\", \"yinlong-shou\")

